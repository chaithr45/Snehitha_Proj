# Test build for QEMU (ESP32 only):
#   idf.py -B build_qemu -D SDKCONFIG=build_qemu/sdkconfig \
#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.qemu" set-target esp32 build
CONFIG_SAFETY_REPLAY=y
CONFIG_SAFETY_MODEL_SELFTEST=y
CONFIG_SAFETY_NET_OPENETH=y
CONFIG_SAFETY_SUPERVISOR_URL="http://10.0.2.2:8080"
CONFIG_SAFETY_WORKER_ID="qemu-replay"
